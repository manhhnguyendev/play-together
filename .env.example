# Copy to .env before `docker compose up`. Every value below is read by
# docker-compose.yml; the API itself never loads this file.

# Database
POSTGRES_DB=playtogether
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Token signing — must be at least 32 characters and different from each other.
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars

# Browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:8080

# Admin bundle API path. Keep the relative default when the console is served
# by the nginx container, which proxies /api to the API service.
ADMIN_API_URL=/api/v2

# Outgoing email for OTP delivery. Leave SMTP_HOST empty and the API logs codes
# instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
